---
import type { HTMLAttributes } from "astro/types";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The name shown as the page title. */
  name?: string;
  /** Small line of text above the name. */
  location?: string;
  /** Body copy under the name. */
  summary?: string;
}

const {
  render = true,
  name,
  location,
  summary,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && (name || location || summary) && (
    <div class:list={["hero_wrap", className]} {...rest}>
      <ContentWrapper variant="card">
        <Eyebrow>{location}</Eyebrow>
        <Heading tag="h1" class="hero_title">
          {name}
        </Heading>
        <Paragraph>{summary}</Paragraph>
      </ContentWrapper>
    </div>
  )
}

<script>
  const hero = document.querySelector<HTMLElement>(".hero_title");
  const navTitle = document.querySelector<HTMLElement>(".nav_logo");
  const root = document.documentElement;
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (hero && navTitle) {
    let frame = 0;

    const clear = () => {
      root.style.removeProperty("--_title-x");
      root.style.removeProperty("--_title-y");
      root.style.removeProperty("--_title-scale");
      root.style.removeProperty("--_title-fade");
    };

    const update = () => {
      frame = 0;
      if (motion.matches) {
        clear();
        return;
      }

      root.style.setProperty("--_title-x", "0px");
      root.style.setProperty("--_title-y", "0px");
      root.style.setProperty("--_title-scale", "1");
      root.style.setProperty("--_title-fade", "0");

      const nav = navTitle.closest(".nav_wrap");
      if (nav?.classList.contains("open")) {
        root.style.setProperty("--_title-x", "0px");
        root.style.setProperty("--_title-y", "0px");
        root.style.setProperty("--_title-scale", "1");
        root.style.setProperty("--_title-fade", "1");
        hero.classList.remove("is-moving");
        return;
      }

      const heroBox = hero.getBoundingClientRect();
      const navBox = navTitle.getBoundingClientRect();
      const section = hero.closest("section");
      const sectionTop = section
        ? section.getBoundingClientRect().top + window.scrollY
        : 0;
      const travel = Math.max((section?.offsetHeight ?? 1) * 0.72, 1);
      const progress = Math.min(
        1,
        Math.max(0, (window.scrollY - sectionTop) / travel),
      );
      const heroFont = Number.parseFloat(getComputedStyle(hero).fontSize);
      const navFont = Number.parseFloat(getComputedStyle(navTitle).fontSize);
      const scale =
        heroFont > 0 ? 1 - (1 - navFont / heroFont) * progress : 1;
      const x = (navBox.left - heroBox.left) * progress;
      const y =
        (navBox.top +
          navBox.height / 2 -
          (heroBox.top + heroBox.height / 2)) *
        progress;
      const fade = Math.min(1, Math.max(0, (progress - 0.55) / 0.45));

      hero.classList.toggle("is-moving", progress > 0.02 && fade < 1);
      root.style.setProperty("--_title-x", `${x}px`);
      root.style.setProperty("--_title-y", `${y}px`);
      root.style.setProperty("--_title-scale", String(scale));
      root.style.setProperty("--_title-fade", String(fade));
    };

    const request = () => {
      if (frame) return;
      frame = requestAnimationFrame(update);
    };

    const nav = navTitle.closest(".nav_wrap");
    if (nav) {
      new MutationObserver(request).observe(nav, {
        attributes: true,
        attributeFilter: ["class"],
      });
    }

    document.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request);
    window.addEventListener("load", request);
    window.addEventListener("hashchange", request);
    motion.addEventListener("change", request);
    request();
  }
</script>

<style is:global>
  @layer components {
    .hero_wrap {
      width: 100%;

      .card-layout {
        overflow: visible;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      body:has(.hero_title) .nav_logo {
        opacity: var(--_title-fade, 0);
        transition: none;

        @media (hover: hover) {
          &:hover {
            opacity: calc(var(--_title-fade, 0) * 0.6);
          }
        }
      }

      .hero_title {
        position: relative;
        z-index: 110;
        transform-origin: left center;
        transform: translate3d(var(--_title-x, 0px), var(--_title-y, 0px), 0)
          scale(var(--_title-scale, 1));
        opacity: calc(1 - var(--_title-fade, 0));

        &.is-moving {
          pointer-events: none;
        }
      }
    }
  }
</style>
